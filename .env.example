# Port de l'API Express
PORT=3001
# Chemin du fichier SQLite (créé automatiquement)
DATABASE_PATH=./data/kooka.db

# --- IA ---------------------------------------------------------------------
# Fournisseur : openai, anthropic ou mock (réponses factices).
# Si vide : celui dont la clé est renseignée ci-dessous, sinon mock.
AI_PROVIDER=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Modèle pour les deux appels (par défaut : gpt-5.5 ou claude-opus-5-5)
AI_MODEL=
# …ou un modèle par appel : les suggestions sont fréquentes, un modèle léger suffit souvent
AI_MODEL_SUGGEST=
AI_MODEL_RECIPE=

# Niveau de réflexion par appel (par défaut : low). La réflexion est facturée :
# plus c'est bas, moins ça coûte. OpenAI : none, minimal, low, medium, high.
# Claude : low, medium, high.
AI_EFFORT_SUGGEST=
AI_EFFORT_RECIPE=

# Prix en $ par million de tokens [entrée, sortie], pour afficher le coût de chaque appel
# dans le terminal (prix Claude déjà connus). Ex. : AI_PRICES={"gpt-5.5":[1.25,10]}
AI_PRICES=
