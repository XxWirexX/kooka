# Port de l'API Express
PORT=3001
# Chemin du fichier SQLite (créé automatiquement)
DATABASE_PATH=./data/kooka.db

# --- IA ---------------------------------------------------------------------
# Fournisseur : openai, anthropic ou mock (réponses factices).
# Si vide : celui dont la clé est renseignée ci-dessous, sinon mock.
AI_PROVIDER=
# Modèle (facultatif). Par défaut : gpt-5.5 (OpenAI) ou claude-opus-5-5 (Anthropic).
AI_MODEL=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
