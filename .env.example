# Port de l'API Express
PORT=3001
# Chemin du fichier SQLite (créé automatiquement)
DATABASE_PATH=./data/kooka.db

# Clé API Anthropic. Sans clé, Kooka passe en mode simulé (réponses factices).
ANTHROPIC_API_KEY=
# Modèle utilisé (par défaut : claude-opus-5-5). Ex. claude-sonnet-5-5 pour plus de rapidité.
AI_MODEL=
# Forcer le mode simulé même avec une clé : AI_PROVIDER=mock
AI_PROVIDER=
