# Copie ce fichier en .env.production SUR LE VPS (jamais dans git) et remplis-le.

# Nom de domaine qui pointe vers le VPS (HTTPS automatique).
# Pas de domaine ? Utilise <ip-avec-des-tirets>.sslip.io, ex. 51-75-12-34.sslip.io
KOOKA_DOMAIN=

# Mot de passe pour entrer dans l'app (obligatoire en production)
APP_PASSWORD=
# Clé de signature des sessions : une longue chaîne aléatoire (openssl rand -hex 32).
# La changer déconnecte tous les appareils.
SESSION_SECRET=

# --- IA ---------------------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL_SUGGEST=gpt-5.4-mini
AI_EFFORT_SUGGEST=none
AI_MODEL_RECIPE=gpt-5.5
AI_EFFORT_RECIPE=low
AI_MODEL_ASK=gpt-5.4-mini
AI_EFFORT_ASK=low
# Garde-fou : nombre maximum d'appels IA par heure
AI_CALLS_PER_HOUR=60
# Prix en $ par million de tokens [entrée, sortie], pour le suivi des coûts dans les logs
AI_PRICES=
